<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent voor de commando-runner (scripts/lead/commando/runner.ts, PLAN §2.5).
  installeer-grens.ts vult {{HOME}} in en print het resultaat; Brian zet het zelf in ~/Library/LaunchAgents.
  De runner draait de root-eigen bundel in live-stand en ziet alleen PATH, HOME en LANG.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.lab-b.commando</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/bun</string>
    <string>/usr/local/lib/lab-lead/commando-runner.js</string>
    <string>--live</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>{{HOME}}/.local/state/lab-commando/akkoord</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>{{HOME}}</string>
    <key>LANG</key>
    <string>nl_NL.UTF-8</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/</string>
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>2</integer>
  <key>StandardOutPath</key>
  <string>{{HOME}}/Library/Logs/lab-b/commando-runner.log</string>
  <key>StandardErrorPath</key>
  <string>{{HOME}}/Library/Logs/lab-b/commando-runner.log</string>
</dict>
</plist>
